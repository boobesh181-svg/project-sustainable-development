# Example .env for backend

# Application environment
ENV=local

# Primary Postgres target (recommended)
# If using backend/docker-compose.yml (db mapped to 5433 on host):
# DATABASE_URL=postgresql+asyncpg://windsurf:windsurf_pass@127.0.0.1:5433/windsurf
# If using root docker-compose.yml (db mapped to 5432 on host):
# DATABASE_URL=postgresql+asyncpg://windsurf:windsurf_pass@127.0.0.1:5432/windsurf

# Set one DATABASE_URL (example default below uses backend compose port mapping)
DATABASE_URL=postgresql+asyncpg://windsurf:windsurf_pass@127.0.0.1:5433/windsurf

SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# CORS allowed origins (comma separated)
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload root directory
UPLOAD_ROOT=./uploads

# Grid emission factor (kg CO2 per kWh)
GRID_EMISSION_FACTOR=0.82
